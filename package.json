{
  "name": "metvuw-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "prod": "rm -rf ./.next && npm run build && npm run start",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest --ui",
    "test:ci": "vitest run --reporter=junit --outputFile.junit=reports/junit.xml",
    "e2e": "npx playwright test",
    "e2e:build": "node e2e/stub/with-stub.mjs npm run build",
    "e2e:interactive": "npx playwright test --ui",
    "checkly:test": "npx checkly test",
    "checkly:deploy": "npx checkly deploy"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@serwist/next": "^9.2.1",
    "cheerio": "1.2.0",
    "clsx": "^2.1.0",
    "date-fns": "4.4.0",
    "jotai": "3.0.1",
    "motion": "^14.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "^9.0.15",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/ui": "^5.0.0",
    "checkly": "^9.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
