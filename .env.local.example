# Copy to .env.local. Everything here is optional: the app builds and runs with
# none of it set. NEXT_PUBLIC_* values are inlined at build time.

# Google Analytics measurement id (for example G-XXXXXXXXXX). Analytics is
# disabled when this is unset.
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# AdSense ad unit slot id. Ad cards are not rendered when this is unset.
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# AdSense publisher id, if it differs from the site's own default.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Vercel sets this to the production domain; it is used for canonical and
# OpenGraph URLs. Outside Vercel it defaults to http://localhost:3002.
# VERCEL_PROJECT_PRODUCTION_URL=example.com

# Playwright: run the e2e tests against an already deployed site instead of
# starting the app locally.
# PLAYWRIGHT_TEST_BASE_URL=https://example.com
